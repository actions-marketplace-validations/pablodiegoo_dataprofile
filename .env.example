# ============================================================================
# DataProfile — Local Environment & Curriculum Overrides (Copy to .env)
# NEVER commit your actual .env file.
#
# Any variable set here (or in GitHub Actions Variables/Secrets) overrides the
# corresponding field in `profile.yaml`. Use `[item 1; item 2]` (brackets +
# semicolons, escaping literal semicolons as `\;`) for lists or multiline text.
# Run `go run ./cmd/dataprofile sync` to sync `.env` with GitHub Actions.
# ============================================================================

# --- Subject Identity & Narrative Overrides (optional) ----------------------
# SUBJECT_NAME="Your Name"
# SUBJECT_ROLE="Data Scientist & Analytics Engineer"
# SUBJECT_LOCALE="en" # "en" | "pt-BR"
# SUBJECT_HEADLINES=[Welcome people and mystical beings.; I'm Your Name! 👋; Working with data 10+ years]
# SUBJECT_BIO=[First paragraph of your career bio.; Second paragraph of your career bio.]

# --- Upstream Source Overrides (optional) -----------------------------------
# Note: GH_* aliases (GH_USERNAME, GH_INCLUDE_FORKS, GH_INCLUDE_PRIVATE_COUNT,
# GH_EXCLUDE_REPOS, GH_EXCLUDE_LANGS) are also accepted for GitHub Actions Variables.
# GITHUB_USERNAME="your-github-username"
# GITHUB_INCLUDE_FORKS=false
# GITHUB_INCLUDE_PRIVATE_COUNT=true
# GITHUB_EXCLUDE_REPOS=[legacy-fork; scratch-notes]
# GITHUB_EXCLUDE_LANGS=[HTML; CSS; SCSS; TeX; G-code; Roff; Liquid; Blade; Rich Text Format; Batchfile]

# KAGGLE_USERNAME="your-kaggle-username"
# KAGGLE_ENABLED=true
# KAGGLE_MODE="hybrid" # "hybrid" | "browser" | "api"

# HF_USERNAME="your-hf-username"
# HF_ENABLED=true

# --- Normalization & Output Overrides (optional) ----------------------------
# DEFLATE_NOTEBOOKS=true
# DETECT_DATA_STACK=true
# OUTPUT_DIRECTORY="generated"
# OUTPUT_SCHOOLS=[tufte; few; cairo; holmes]
# OUTPUT_PANELS=[summary; languages; stack; kaggle; impact; header; bio; bio-full; full]

# --- Authentication Tokens & Credentials (Secrets) --------------------------
# GitHub Personal Access Token (optional locally; required for private repos & repo traffic views)
# Recommended scopes: read:user, repo (if including private metadata)
ACCESS_TOKEN=

# Fallback standard GitHub token (automatically provided in GitHub Actions)
GITHUB_TOKEN=

# Optional Kaggle username and REST API v1 credentials (enriches dataset/notebook votes, downloads & private counts)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Optional Hugging Face Hub token (includes private models, datasets & spaces in aggregate counts)
HF_TOKEN=
