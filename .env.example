# ============================================================================
# DataProfile — Local Environment Variables (Copy to .env for local testing)
# NEVER commit your actual .env file. In GitHub Actions, configure these as
# Repository Secrets (Settings -> Secrets and variables -> Actions).
# ============================================================================

# GitHub Personal Access Token (optional locally; required for private repos & repo traffic views)
# Recommended scopes: read:user, repo (if including private metadata)
ACCESS_TOKEN=

# Fallback standard GitHub token (automatically provided in GitHub Actions)
GITHUB_TOKEN=

# Optional Kaggle REST API v1 credentials (enriches dataset/notebook votes & downloads)
KAGGLE_USERNAME=
KAGGLE_KEY=
